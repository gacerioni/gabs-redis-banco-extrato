# Copie pra `.env` e preencha com a sua chave OpenAI.
#
#   cp .env.example .env
#   $EDITOR .env

# ----------------------------------------------------------------------
# Obrigatória — usada pelo LLM rewriter (gpt-4o-mini) + embeddings
# (text-embedding-3-small, 1536d) durante o seed.
# ----------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# ----------------------------------------------------------------------
# Opcional — override de modelos. Defaults batem o melhor custo/qualidade
# pra essa demo.
# ----------------------------------------------------------------------
# CHAT_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small

# ----------------------------------------------------------------------
# Opcional — tag da imagem pro `docker compose pull`. Em dev fica em
# `latest`; em prod a gente pina (ex: 0.1.1-alpha).
# ----------------------------------------------------------------------
# IMAGE_TAG=latest

# ----------------------------------------------------------------------
# Opcional — porta do Redis exposta no host pra inspeção
# (redis-cli -p 6380). Mude se já tiver outro Redis local.
# ----------------------------------------------------------------------
# REDIS_HOST_PORT=6380
